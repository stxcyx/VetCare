@model Mascota
@{
    ViewData["Title"] = "Ficha de " + Model.Nombre;
}

<h1>
    @Model.Nombre
    @if (Model.Activa)
    {
        <span class="badge bg-success fs-6">Activa</span>
    }
    else
    {

        <span class="badge bg-secondary fs-6">Inactiva</span>
    }
</h1>
<hr />
<dl class="row">
    <dt class="col-sm-3">Dueño</dt>
    <dd class="col-sm-9">
        <a asp-controller="Clientes" asp-action="Details" asp-route-id="@Model.ClienteId">
            @Model.Cliente?.Nombre @Model.Cliente?.Apellidos
        </a>
    </dd>
    <dt class="col-sm-3">Especie</dt>
    <dd class="col-sm-9">@Model.Especie?.Nombre</dd>
    <dt class="col-sm-3">Raza</dt>
    <dd class="col-sm-9">@Model.Raza</dd>
    <dt class="col-sm-3">Sexo</dt>
    <dd class="col-sm-9">@Model.Sexo</dd>
    <dt class="col-sm-3">Fecha de nacimiento</dt>
    <dd class="col-sm-9">@Model.FechaNacimiento.ToString("dd/MM/yyyy")</dd>
    <dt class="col-sm-3">Edad</dt>
    <dd class="col-sm-9">@Model.Edad</dd>
    <dt class="col-sm-3">Peso</dt>
    <dd class="col-sm-9">@Model.PesoKg.ToString("0.0", CultureInfo.GetCultureInfo("es-CR")) kg</dd>
</dl>

<h4>Historial de citas</h4>
@if (!Model.Citas.Any())
{
    <p>Sin citas registradas</p>
}
else
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Fecha y hora</th>
                <th>Veterinario</th>
                <th>Motivo</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Citas)
            {
                <tr>
                    <td>@c.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@c.Veterinario?.Nombre</td>
                    <td>@c.Motivo</td>
                    <td>@c.Estado</td>
                </tr>
            }
        </tbody>
    </table>
}

<div>
    @if (User.IsInRole("Administrador") || User.IsInRole("Recepcionista"))
    {
        <a asp-action="Edit" asp-route-id="@Model.MascotaId" class="btn btn-secondary">Editar</a>
    }
    <a asp-action="Index" class="btn btn-outline-primary">Volver</a>
</div>