@using VetCare.Abstracciones.Modelos

@model Cita

@{
    ViewData["Title"] = "Detalle de atención";

    var productos = ViewBag.Productos as List<ProductoAtencionDetalle>
        ?? new List<ProductoAtencionDetalle>();
}

<div class="container-fluid py-4">

    <!-- Encabezado -->

    <div class="d-flex justify-content-between
                align-items-center flex-wrap gap-3 mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                Detalle de atención veterinaria
            </h2>

            <p class="text-muted mb-0">
                Información clínica y productos utilizados.
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Volver

        </a>

    </div>

    <!-- Información de la cita -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header text-white py-3"
             style="background-color: #194B85;">

            <h6 class="fw-bold mb-0">
                <i class="bi bi-calendar-check me-2"></i>
                Información de la cita
            </h6>

        </div>

        <div class="card-body p-4">

            <div class="row g-4">

                <div class="col-12 col-md-3">

                    <small class="text-muted">
                        Número de cita
                    </small>

                    <p class="fw-bold mb-0">
                        #@Model.CitaId
                    </p>

                </div>

                <div class="col-12 col-md-3">

                    <small class="text-muted">
                        Fecha y hora
                    </small>

                    <p class="fw-bold mb-0">
                        @Model.FechaHora.ToString("dd/MM/yyyy HH:mm")
                    </p>

                </div>

                <div class="col-12 col-md-3">

                    <small class="text-muted">
                        Mascota
                    </small>

                    <p class="fw-bold mb-0">
                        @Model.NombreMascota
                    </p>

                </div>

                <div class="col-12 col-md-3">

                    <small class="text-muted">
                        Veterinario
                    </small>

                    <p class="fw-bold mb-0">
                        @Model.NombreVeterinario
                    </p>

                </div>

                <div class="col-12 col-md-6">

                    <small class="text-muted">
                        Motivo de la cita
                    </small>

                    <p class="fw-bold mb-0">
                        @Model.Motivo
                    </p>

                </div>

                <div class="col-12 col-md-6">

                    <small class="text-muted">
                        Estado
                    </small>

                    <p class="mb-0">

                        <span class="badge bg-success">
                            Atendida
                        </span>

                    </p>

                </div>

            </div>

        </div>

    </div>

    <!-- Información clínica -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header text-white py-3"
             style="background-color: #194B85;">

            <h6 class="fw-bold mb-0">
                <i class="bi bi-clipboard2-pulse me-2"></i>
                Información clínica
            </h6>

        </div>

        <div class="card-body p-4">

            <div class="row g-3">

                <div class="col-12 col-md-6">

                    <div class="bg-light rounded p-3 h-100">

                        <h6 class="fw-bold text-primary">
                            Diagnóstico
                        </h6>

                        <p class="mb-0"
                           style="white-space: pre-wrap;">@(Model.Diagnostico ?? "Sin diagnóstico registrado.")</p>

                    </div>

                </div>

                <div class="col-12 col-md-6">

                    <div class="bg-light rounded p-3 h-100">

                        <h6 class="fw-bold text-primary">
                            Tratamiento
                        </h6>

                        <p class="mb-0"
                           style="white-space: pre-wrap;">@(Model.Tratamiento ?? "Sin tratamiento registrado.")</p>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Productos utilizados -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header text-white py-3"
             style="background-color: #194B85;">

            <h6 class="fw-bold mb-0">
                <i class="bi bi-box-seam me-2"></i>
                Productos utilizados
            </h6>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>
                        <th>ID</th>
                        <th>Producto</th>
                        <th>Cantidad utilizada</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var producto in productos)
                    {
                        <tr>

                            <td>
                                @producto.ProductoId
                            </td>

                            <td>
                                @producto.Nombre
                            </td>

                            <td>

                                <span class="badge bg-primary">
                                    @producto.Cantidad unidades
                                </span>

                            </td>

                        </tr>
                    }

                    @if (!productos.Any())
                    {
                        <tr>

                            <td colspan="3"
                                class="text-center text-muted py-4">

                                No se registraron productos en esta atención.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="card-footer bg-white">

            <small class="text-muted">
                Productos registrados: @productos.Count
            </small>

        </div>

    </div>

</div>