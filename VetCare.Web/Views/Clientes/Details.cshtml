@model Cliente
@{
    ViewData["Title"] = "Detalle del cliente";
}

<h1>Detalle del cliente</h1>
<hr />
<dl class="row">
    <dt class="col-sm-3">Cédula</dt>
    <dd class="col-sm-9">@Model.Cedula</dd>
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre @Model.Apellidos</dd>
    <dt class="col-sm-3">Teléfono</dt>
    <dd class="col-sm-9">@Model.Telefono</dd>
    <dt class="col-sm-3">Correo</dt>
    <dd class="col-sm-9">@Model.Correo</dd>
    <dt class="col-sm-3">Dirección</dt>
    <dd class="col-sm-9">@Model.Direccion</dd>
    <dt class="col-sm-3">Fecha de registro</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.FechaRegistro)</dd>
</dl>

<h4>Mascotas</h4>
@if (!Model.Mascotas.Any())
{
    <p>Sin mascotas registradas</p>
}
else
{
    <ul>
        @foreach (var m in Model.Mascotas)
        {
            <li><a asp-controller="Mascotas" asp-action="Details" asp-route-id="@m.MascotaId">@m.Nombre</a></li>
        }
    </ul>
}
@if (User.IsInRole("Administrador") || User.IsInRole("Recepcionista"))
{
    <p><a asp-controller="Mascotas" asp-action="Create" asp-route-clienteId="@Model.ClienteId" class="btn btn-sm btn-success">Agregar mascota</a></p>
}