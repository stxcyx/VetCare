@model IEnumerable<Cliente>
@{
    ViewData["Title"] = "Clientes";
    int pagina = ViewBag.Pagina;
    int totalPaginas = ViewBag.TotalPaginas;
    bool puedeEditar = User.IsInRole("Administrador") || User.IsInRole("Recepcionista");
    bool esAdmin = User.IsInRole("Administrador");
}

<div class="vc-encabezado">
    <div>
        <p class="vc-ruta">Gestión clínica / Clientes</p>
        <h1>Clientes</h1>
        <p class="vc-subtitulo">Registro y administración de propietarios de mascotas</p>
    </div>
    @if (puedeEditar)
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nuevo registro</a>
    }
</div>

<div class="vc-tabla-card">
    <form asp-action="Index" method="get" class="vc-filtros">
        <div class="vc-filtro-busqueda">
            <i class="bi bi-search"></i>
            <input name="buscar" value="@ViewBag.Buscar" placeholder="Buscar en clientes..." />
        </div>
        <button type="submit" class="vc-filtro-boton">Buscar</button>
    </form>

    @if (!Model.Any())
    {
        <p class="vc-vacio">No se encontraron clientes</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table vc-tabla mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Cédula</th>
                        <th>Nombre completo</th>
                        <th>Teléfono</th>
                        <th>Correo</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.ClienteId</td>
                            <td>@c.Cedula</td>
                            <td><a asp-action="Details" asp-route-id="@c.ClienteId" class="vc-link-fila">@c.Nombre @c.Apellidos</a></td>
                            <td>@c.Telefono</td>
                            <td>@c.Correo</td>
                            <td class="text-center text-nowrap">
                                <a asp-action="Details" asp-route-id="@c.ClienteId" class="vc-pill vc-pill-ver">Ver</a>
                                @if (puedeEditar)
                                {
                                    <a asp-action="Edit" asp-route-id="@c.ClienteId" class="vc-pill vc-pill-editar">Editar</a>
                                }
                                @if (esAdmin)
                                {
                                    <a asp-action="Delete" asp-route-id="@c.ClienteId" class="vc-pill vc-pill-eliminar">Eliminar</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (totalPaginas > 1)
{
    <nav>
        <ul class="pagination">
            @for (var p = 1; p <= totalPaginas; p++)
            {
                <li class="page-item @(p == pagina ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@p" asp-route-buscar="@ViewBag.Buscar">@p</a>
                </li>
            }
        </ul>
    </nav>
}