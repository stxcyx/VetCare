@model Producto

@{
    ViewData["Title"] = "Editar producto";
}

<div class="vc-encabezado">
    <div>
        <p class="vc-ruta">
            Gestión clínica / Inventario / Editar
        </p>

        <h1>Editar producto</h1>

        <p class="vc-subtitulo">
            Actualice la información del producto registrado
        </p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Volver
    </a>
</div>

<div class="card border-0 shadow-sm">

    <div class="card-body p-4">

        <h5 class="fw-bold mb-4">
            Información del producto
        </h5>

        <form asp-action="Edit"
              asp-route-id="@Model.ProductoId"
              method="post">

            <input type="hidden" asp-for="ProductoId" />

            <partial name="_Formulario" model="Model" />

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2 flex-wrap">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancelar
                </a>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-floppy"></i> Guardar cambios
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}